{
    "name": "git-constellation/git-constellation",
    "description": "Generate a GitHub contribution constellation for profile READMEs.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "symfony/dotenv": "^7.4",
        "symfony/http-client": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "GitConstellation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GitConstellation\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "demo": "php bin/constellation --demo"
    }
}
